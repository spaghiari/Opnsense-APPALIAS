# os-appalias : après une mise à jour, le relais en cours d'exécution garde
# l'ancien code en mémoire (le rechargement SIGHUP ne relit que la
# configuration). On le redémarre s'il tourne ; sinon rien.
if /usr/local/etc/rc.d/appaliasd onestatus > /dev/null 2>&1; then
	echo "Restarting appaliasd"
	/usr/local/etc/rc.d/appaliasd onerestart > /dev/null 2>&1 || true
fi

# Catalogue v2fly : premier rafraîchissement en ligne en tâche de fond, si
# l'option est active (--if-enabled lit config.json). Jamais bloquant :
# daemon(8) détache le processus ; en cas d'échec, le cron quotidien reprend.
/usr/sbin/daemon -f /usr/local/bin/python3 /usr/local/opnsense/scripts/OPNsense/AppAlias/catalog_update.py update --if-enabled > /dev/null 2>&1 || true

# Sources ASN : récupère en tâche de fond les préfixes des applications qui
# n'en ont pas encore (--if-needed). Le script ne contacte RIPEstat que si le
# plugin et les sources ASN sont activés dans config.json.
# Jamais bloquant ; en cas d'échec, le cron quotidien reprend.
/usr/sbin/daemon -f /usr/local/bin/python3 /usr/local/opnsense/scripts/OPNsense/AppAlias/asn_update.py update --if-needed > /dev/null 2>&1 || true

# Suivi automatique du catalogue : un catalogue embarqué plus récent arrive
# avec le paquet ; les applications qui le suivent reçoivent ses nouveautés
# (migration du modèle déjà faite à ce stade). Sans changement, rien n'est
# enregistré ni appliqué. En tâche de fond, jamais bloquant.
/usr/sbin/daemon -f /usr/local/opnsense/scripts/OPNsense/AppAlias/catalog_follow.php run > /dev/null 2>&1 || true

# Données de l'ancienne fonction Discovery (retirée). Supprimées APRÈS le
# redémarrage du démon : l'ancien code réécrivait discovery.json à son arrêt.
rm -f /var/db/appalias/discovery.json /var/db/appalias/discovery.ctl.json /var/db/appalias/.discovery.*.tmp
